<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
    <Grid MinWidth="600" MinHeight="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Method title -->
        <Border Grid.Row="0"
                Background="{DynamicResource {x:Static colors:ThemedDialogColors.GridHeadingBackgroundBrushKey}}"
                Padding="8,4">
            <TextBlock Text="{Binding Title, Mode=OneWay}"
                       FontFamily="Consolas"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource {x:Static colors:ThemedDialogColors.WindowPanelTextBrushKey}}"
                       TextWrapping="Wrap" />
        </Border>
        <!-- Metadata block -->
        <Border Grid.Row="1"
                Visibility="{Binding MetadataText, Converter={x:Static vs:Converters.StringToVisibilityConverter}}"
                Background="{DynamicResource {x:Static colors:ThemedDialogColors.ListItemBackgroundBrushKey}}"
                BorderBrush="{DynamicResource {x:Static colors:ThemedDialogColors.GridLineBrushKey}}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <TextBlock Text="{Binding MetadataText, Mode=OneWay}"
                       FontFamily="Consolas"
                       FontSize="11"
                       Foreground="{DynamicResource {x:Static colors:ThemedDialogColors.WindowPanelTextBrushKey}}"
                       TextWrapping="Wrap" />
        </Border>
        <!-- IL instructions list -->
        <ListView Grid.Row="2"
                  ItemsSource="{Binding Lines}"
                  BorderThickness="0"
                  Background="{DynamicResource {x:Static colors:ThemedDialogColors.WindowPanelFillBrushKey}}"
                  HorizontalContentAlignment="Stretch"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static colors:ThemedDialogColors.ActionButtonStrokeHoverBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static colors:ThemedDialogColors.ListItemMouseOverBrushKey}}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <!-- Normal instruction line -->
                        <StackPanel Orientation="Horizontal"
                                    TextBlock.FontFamily="Consolas"
                                    TextBlock.FontSize="12"
                                    Visibility="{Binding IsMarker, Converter={x:Static vs:Converters.BoolToInverseVisibilityConverter}}">
                            <!-- Offset: IL_0000:  -->
                            <TextBlock Text="{Binding OffsetText, Mode=OneWay}"
                                       Foreground="Gray"
                                       MinWidth="72" />
                            <!-- Bytes (optional, hidden when empty) -->
                            <TextBlock Text="{Binding BytesText, Mode=OneWay}"
                                       Foreground="DarkGreen"
                                       FontSize="11" />
                            <!-- Indentation -->
                            <TextBlock Text="{Binding IndentText, Mode=OneWay}" />
                            <!-- OpCode keyword (blue) -->
                            <TextBlock Text="{Binding OpCodeText, Mode=OneWay}"
                                       Foreground="#FF0070C1"
                                       MinWidth="80" />
                            <!-- Operand (default foreground; dark red for string literals) -->
                            <TextBlock FontFamily="Consolas" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding OperandText, Mode=OneWay}" />
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:ThemedDialogColors.WindowPanelTextBrushKey}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStringOperand}" Value="True">
                                                <Setter Property="Foreground" Value="#FFA31515" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <!-- Exception handler marker line -->
                        <StackPanel Orientation="Horizontal"
                                    TextBlock.FontFamily="Consolas"
                                    TextBlock.FontSize="12"
                                    Visibility="{Binding IsMarker, Converter={x:Static vs:Converters.BoolToVisibilityConverter}}">
                            <!-- Marker ID (gray, aligned with offset column) -->
                            <TextBlock Text="{Binding OffsetText, Mode=OneWay}"
                                       Foreground="Gray"
                                       MinWidth="72" />
                            <!-- Skip bytes column if present -->
                            <TextBlock Text="{Binding BytesText, Mode=OneWay}"
                                       Foreground="Transparent" />
                            <!-- Indentation -->
                            <TextBlock Text="{Binding IndentText, Mode=OneWay}" />
                            <!-- Keyword (.try, finally, catch …) in dark cyan -->
                            <TextBlock Text="{Binding OpCodeText, Mode=OneWay}"
                                       Foreground="#FF007070" />
                            <!-- Rest of marker text -->
                            <TextBlock Text="{Binding OperandText, Mode=OneWay}"
                                       Foreground="#FF267326" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</DataTemplate>
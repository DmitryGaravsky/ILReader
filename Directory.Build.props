<Project>
  <PropertyGroup>
    <!-- Ensure distinct output per TFM/configuration across the repo. -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <BaseOutputPath>..\bin.NetFW\</BaseOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net8.0-windows'">
    <BaseOutputPath>..\bin.NET\</BaseOutputPath>
  </PropertyGroup>
</Project>
